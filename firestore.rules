rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function preservesPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isAdmin', 'isPro', 'role', 'banned', 'active']);
    }

    function communitySetupPath(setupId) {
      return /databases/$(database)/documents/communitySetups/$(setupId);
    }

    function communitySetupData(setupId) {
      return get(communitySetupPath(setupId)).data;
    }

    function canReadCommunitySetup() {
      return resource.data.status == 'PUBLISHED'
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isAdmin();
    }

    function isCommunitySetupAuthor() {
      return isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    function authorMayUpdateCommunitySetup() {
      return isCommunitySetupAuthor()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status == 'PENDING_REVIEW'
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ratingAverage', 'ratingCount', 'favoriteCount', 'reportCount']);
    }

    function onlyCommunityCountersUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['favoriteCount', 'reportCount', 'updatedAtMs']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isPro', false) == false
        && request.resource.data.get('role', 'USER') == 'USER'
        && request.resource.data.get('banned', false) == false;
      allow update: if isAdmin() || (isSelf(userId) && preservesPrivilegedUserFields());
      allow delete: if isAdmin();

      match /devices/{deviceId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      match /vehicles/{vehicleId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      match /toolSessions/{sessionId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      match /favoriteSetups/{setupId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }
    }

    match /error_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /appConfig/{docId} {
      allow read, write: if isAdmin();
    }

    match /settingsContent/{languageCode} {
      allow read: if isSignedIn() && languageCode in ["de", "en"];
      allow write: if isAdmin() && languageCode in ["de", "en"];
    }

    match /changelog/{languageCode} {
      allow read: if isSignedIn() && languageCode in ["de", "en"];
      allow write: if isAdmin() && languageCode in ["de", "en"];
    }

    match /vehicleCatalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /engineCatalog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /communitySetups/{setupId} {
      allow read: if canReadCommunitySetup();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'PENDING_REVIEW';
      allow update: if isAdmin() || authorMayUpdateCommunitySetup() || onlyCommunityCountersUpdate();
      allow delete: if isAdmin() || isCommunitySetupAuthor();

      match /ratings/{userId} {
        allow read: if isAdmin()
          || (exists(communitySetupPath(setupId))
              && (communitySetupData(setupId).status == 'PUBLISHED'
                  || (isSignedIn() && communitySetupData(setupId).authorId == request.auth.uid)));
        allow create, update: if isSelf(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5
          && (request.resource.data.value > 2
              || (request.resource.data.comment is string
                  && request.resource.data.comment.size() >= 3))
          && exists(communitySetupPath(setupId))
          && communitySetupData(setupId).status == 'PUBLISHED'
          && communitySetupData(setupId).authorId != request.auth.uid;
        allow delete: if isSelf(userId) || isAdmin();
      }

      match /reports/{reportId} {
        allow read: if isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.reporterId == request.auth.uid
          && exists(communitySetupPath(setupId));
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
